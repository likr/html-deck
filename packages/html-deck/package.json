{
  "name": "html-deck",
  "version": "1.0.0-alpha.2",
  "license": "MIT",
  "description": "An Agent-First WebComponents Slideshow Library",
  "author": "Yosuke Onoue <onoue@likr-lab.com>",
  "homepage": "https://github.com/likr/html-deck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likr/html-deck.git",
    "directory": "packages/html-deck"
  },
  "bugs": {
    "url": "https://github.com/likr/html-deck/issues"
  },
  "keywords": [
    "slideshow",
    "presentation",
    "webcomponents",
    "agent-first",
    "deck",
    "html"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "dist/html-deck.js",
  "module": "dist/html-deck.js",
  "exports": {
    ".": {
      "development": "./src/html-deck.js",
      "default": "./dist/html-deck.js"
    },
    "./theme-corporate": "./dist/themes/html-deck.theme-corporate.css",
    "./theme-dark": "./dist/themes/html-deck.theme-dark.css",
    "./theme-dotted": "./dist/themes/html-deck.theme-dotted.css",
    "./theme-neon": "./dist/themes/html-deck.theme-neon.css",
    "./theme-nouveau": "./dist/themes/html-deck.theme-nouveau.css",
    "./theme-serif": "./dist/themes/html-deck.theme-serif.css",
    "./theme-warm": "./dist/themes/html-deck.theme-warm.css",
    "./themes/*": "./dist/themes/*",
    "./presenter": {
      "development": "./src/html-deck-presenter.js",
      "default": "./dist/html-deck-presenter.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0"
  }
}
